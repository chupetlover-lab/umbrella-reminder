# Anthropic API キー(任意)。設定すると論文の日本語要約・構造化にLLMを使用します。
# 未設定の場合はキーワードベースの簡易フォールバック(未翻訳)になります。
ANTHROPIC_API_KEY=

# 使用するモデルID(任意。既定値は claude-sonnet-5)
ANTHROPIC_MODEL=claude-sonnet-5

# NCBI (PubMed) APIキー(任意)。設定するとリクエスト上限が緩和されます。
# https://www.ncbi.nlm.nih.gov/account/settings/ から取得できます。
NCBI_API_KEY=

# 何日前までの新着論文を検索対象にするか(既定値: 3)
DIGEST_LOOKBACK_DAYS=3

# 1日のダイジェストに含める最大論文数(既定値: 15)
DIGEST_MAX_PAPERS=15
